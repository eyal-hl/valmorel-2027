rules_version = '2';

// Paste these into Firebase console → Firestore Database → Rules → Publish.
//
// A trip's id is long and random, and it is the invite: knowing it lets a
// signed-in phone add itself to the member list, and nothing else. Only
// members can read or write the trip's data. Trips can't be listed, so ids
// can't be discovered.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /trips/{tripId} {
      function isMember() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }

      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;
      allow delete: if false;

      allow create: if signedIn()
        && tripId.size() >= 20
        && request.resource.data.keys().hasOnly(['members', 'created'])
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 8
        )
      );

      match /{document=**} {
        allow read, write: if isMember();
      }
    }
  }
}
